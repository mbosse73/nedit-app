{
  "permissions": {
    "allow": [
      "Bash(node werkzeug/pruefen.mjs)",
      "Bash(node werkzeug/lage.mjs)",
      "Bash(node werkzeug/schau.mjs:*)",
      "Bash(node werkzeug/bau-mockups.mjs)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "Grep",
      "Glob"
    ],
    "deny": [
      "Bash(npm install:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node werkzeug/lage.mjs", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node werkzeug/haken-pruefen.mjs", "timeout": 60 }
        ]
      }
    ]
  }
}
